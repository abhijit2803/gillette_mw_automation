# Environment Configuration for Playwright Tests
# Copy this file to .env and update with your preferred settings

# Environment to use (dev/qa/prod)
# Default: dev (if not specified)
TEST_ENV=dev

# Override base URL if needed (optional)
BASE_URL=https://dev.braun.com/en-us

# Test credentials (optional - will use defaults from test-data/users.json)
TEST_EMAIL=afzal.ali@ltimindtree.com
TEST_PASSWORD=Password@21

# Additional test users (if needed)
TEST_EMAIL_2=test.user2@example.com
TEST_PASSWORD_2=Test@5678

# Timeout settings (optional)
TIMEOUT_SHORT=5000
TIMEOUT_MEDIUM=10000
TIMEOUT_LONG=30000

# API settings (optional)
# API_URL=https://api-dev.braun.com

# Example configurations:
# 
# For DEV environment (default):
# TEST_ENV=dev
# 
# For QA environment:
# TEST_ENV=qa
# 
# For PROD environment (use with caution):
# TEST_ENV=prod
